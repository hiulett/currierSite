{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "npm run build*": "allow",
      "composer test*": "allow",
      "php artisan test*": "allow",
      "php vendor/bin/phpunit*": "allow"
    }
  },
  "tool_output": { "max_lines": 150, "max_bytes": 8192 },
  "compaction": { "auto": true, "tail_turns": 15 }
}
